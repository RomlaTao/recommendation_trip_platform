# ML Model Service — copy to `.env` in this directory for local `uvicorn` only.
# When running via root `docker compose`, variables are injected from the repo root `.env`.

DEBUG=false
HOST=0.0.0.0
PORT=8001

# ML database (Postgres riêng; cổng 5433 khi chạy cùng compose với platform 5432)
ML_DB_HOST=127.0.0.1
ML_DB_PORT=5433
ML_DB_USERNAME=postgres
ML_DB_PASSWORD=postgres
ML_DB_DATABASE=recommendation_trip_ml

# Seed projection DB from CSV on startup (paths relative to cwd; from this folder use ../../dataset/...)
ML_SEED_ON_START=true
PLACE_CSV_PATH=../../dataset/places.csv
CATEGORY_FOR_PLACES_CSV_PATH=../../dataset/categories.csv

# RabbitMQ (compose overrides host to `rabbitmq`)
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Must match platform outbox relay (default same as root .env.example)
PLACE_ML_RABBITMQ_EXCHANGE=place.events
PLACE_ML_RABBITMQ_ROUTING_KEY=place.projection.v1
PLACE_PROJECTION_CONSUMER_ENABLED=true
