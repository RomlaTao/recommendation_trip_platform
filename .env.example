# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
PORT=3000
# Set to true to automatically seed initial data on every app startup (dev only)
SEED_ON_START=false
# Global route prefix — all endpoints are served under /api/v1/...
API_PREFIX=api/v1

# =============================================================================
# Database (PostgreSQL)
# Matches the docker-compose.yml service above.
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=recommendation_trip_db
DB_LOGGING=false

# =============================================================================
# JWT
# Use two separate secrets so a compromised access secret cannot forge refresh
# tokens and vice-versa.
# =============================================================================
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=1d

JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
# Default role code assigned to new local users (multi-role mapping table).
DEFAULT_USER_ROLE_CODE=USER

# =============================================================================
# Place / category CSV import (seed CLI + SEED_ON_START)
# Paths are relative to services/platform (run npm commands from that directory).
# =============================================================================
PLACE_CSV_PATH=dataset/places.csv
CATEGORY_FOR_PLACES_CSV_PATH=dataset/categories.csv

# =============================================================================
# Queue (Bull + Redis)
# =============================================================================
QUEUE_REDIS_HOST=127.0.0.1
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=

# =============================================================================
# Email (SMTP)
# =============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=no-reply@tripplatform.local
MAIL_SECURE=true

# Verification link used in verify-email emails
EMAIL_VERIFY_BASE_URL=http://localhost:3000/api/v1/auth/verify-email
# 15 minutes default
EMAIL_VERIFY_TOKEN_TTL_SECONDS=900
