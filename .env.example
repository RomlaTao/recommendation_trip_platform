# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
PORT=3000
# Set to true to automatically seed initial data on every app startup (dev only)
SEED_ON_START=false
# Global route prefix — all endpoints are served under /api/v1/...
API_PREFIX=api/v1

# =============================================================================
# Database — Platform (NestJS / TypeORM)
# Compose service: postgres-platform (host port PLATFORM_DB_PORT, default 5432).
# =============================================================================
PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=5432
PLATFORM_DB_USERNAME=postgres
PLATFORM_DB_PASSWORD=postgres
PLATFORM_DB_DATABASE=recommendation_trip_db
PLATFORM_DB_LOGGING=false

# =============================================================================
# Database — ML Model Service (Postgres riêng trong compose: postgres-ml)
# Host port mặc định 5433 để không trùng với platform trên máy bạn.
# =============================================================================
ML_DB_HOST=localhost
ML_DB_PORT=5433
ML_DB_USERNAME=postgres
ML_DB_PASSWORD=postgres
ML_DB_DATABASE=recommendation_trip_ml
# Upsert ML projection tables from CSV on ml-model-service startup (compose mounts ./dataset → /app/dataset).
ML_SEED_ON_START=true

# =============================================================================
# JWT
# Use two separate secrets so a compromised access secret cannot forge refresh
# tokens and vice-versa.
# =============================================================================
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=1d

JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
# Default role code assigned to new local users (multi-role mapping table).
DEFAULT_USER_ROLE_CODE=USER

# =============================================================================
# Place / category CSV (platform SEED_ON_START + ml-model-service ML_SEED_ON_START)
# Platform: paths relative to services/platform cwd. ML in Docker: repo ./dataset mounted at /app/dataset, cwd /app.
# =============================================================================
PLACE_CSV_PATH=dataset/places.csv
CATEGORY_FOR_PLACES_CSV_PATH=dataset/categories.csv

# =============================================================================
# Queue (Bull + Redis)
# =============================================================================
QUEUE_REDIS_HOST=127.0.0.1
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=

# =============================================================================
# RabbitMQ (message broker — ML / outbox relay)
# In Docker Compose, AMQP is exposed on host port RABBITMQ_PORT; management UI on RABBITMQ_MANAGEMENT_PORT.
# =============================================================================
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# =============================================================================
# ML Model Service (host port when using docker compose)
# =============================================================================
ML_SERVICE_PORT=8001

# =============================================================================
# Email (SMTP)
# =============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=no-reply@tripplatform.local
MAIL_SECURE=true

# Verification link used in verify-email emails
EMAIL_VERIFY_BASE_URL=http://localhost:3000/api/v1/auth/verify-email
# 15 minutes default
EMAIL_VERIFY_TOKEN_TTL_SECONDS=900
